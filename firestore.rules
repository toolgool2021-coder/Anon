rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function maintenanceOpen() { return !exists(/databases/$(database)/documents/system/maintenance) || get(/databases/$(database)/documents/system/maintenance).data.enabled != true; }
  function verified() { return signed() && request.auth.token.email_verified == true && (maintenanceOpen() || admin()); }
  function admin() { return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
  match /system/maintenance {
   allow get: if true;
   allow list: if false;
   allow create, update: if admin() && request.resource.data.keys().hasOnly(['enabled','reason','until','updatedAt']) && request.resource.data.enabled is bool && request.resource.data.reason is string && request.resource.data.reason.size() <= 240 && request.resource.data.until is string && request.resource.data.until.size() <= 100 && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /admins/{uid} { allow read: if signed() && request.auth.uid == uid && (maintenanceOpen() || admin()); allow write: if false; }
  match /usernames/{name} {
   allow get: if signed() && (maintenanceOpen() || admin()); allow list: if false;
   allow create: if signed() && (maintenanceOpen() || admin()) && name.matches('^[a-z0-9_]{3,20}$') && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid;
   allow update, delete: if false;
  }
  match /questions/{qid} {
   allow create: if verified() && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/limits/question).data.lastSentAt == request.time && request.resource.data.keys().hasOnly(['text','publicRequested','status','createdAt','answer','answeredAt','published']) && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 800 && request.resource.data.publicRequested is bool && request.resource.data.status == 'sent' && request.resource.data.answer == '' && request.resource.data.published == false && request.resource.data.createdAt == request.time && request.resource.data.answeredAt == null && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/history/$(qid)).data.questionId == qid && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/history/$(qid)).data.text == request.resource.data.text;
   allow get: if admin() || (maintenanceOpen() && signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/history/$(qid))) || (maintenanceOpen() && resource.data.published == true);
   allow list: if admin() || resource.data.published == true;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer','answeredAt','published']) && request.resource.data.status in ['sent','read','answered'] && request.resource.data.answer is string && request.resource.data.answer.size() <= 2000 && (!request.resource.data.published || (resource.data.publicRequested && request.resource.data.status == 'answered' && request.resource.data.answer.size() > 0));
   allow delete: if admin();
  }
  match /users/{uid}/limits/{kind} {
   allow get: if signed() && request.auth.uid == uid && kind == 'question' && (maintenanceOpen() || admin());
   allow list: if false;
   allow create, update: if verified() && request.auth.uid == uid && kind == 'question' && request.resource.data.keys().hasOnly(['lastSentAt']) && request.resource.data.lastSentAt == request.time && (!exists(/databases/$(database)/documents/users/$(uid)/limits/$(kind)) || resource.data.lastSentAt + duration.value(3, 'h') <= request.time);
   allow delete: if false;
  }
  match /users/{uid}/history/{qid} {
   allow read: if signed() && request.auth.uid == uid && (maintenanceOpen() || admin());
   allow create: if verified() && request.auth.uid == uid && getAfter(/databases/$(database)/documents/users/$(uid)/limits/question).data.lastSentAt == request.time && request.resource.data.keys().hasOnly(['questionId','text','publicRequested','createdAt']) && request.resource.data.questionId == qid && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 800 && request.resource.data.publicRequested is bool && request.resource.data.createdAt == request.time && !exists(/databases/$(database)/documents/questions/$(qid)) && getAfter(/databases/$(database)/documents/questions/$(qid)).data.text == request.resource.data.text && getAfter(/databases/$(database)/documents/questions/$(qid)).data.publicRequested == request.resource.data.publicRequested;
   allow update, delete: if false;
  }
 }
}
